PLEX_URL=http://localhost:32400
PLEX_TOKEN=your-plex-token-here

# Optional Tautulli web root + API key. The URL may include Tautulli's HTTP
# root (for example http://localhost:8181/tautulli); the client appends
# /api/v2. Leave both blank/unset to disable the integration.
# TAUTULLI_URL=http://localhost:8181
# TAUTULLI_API_KEY=your-tautulli-api-key-here
# TAUTULLI_TIMEOUT_MS=10000
